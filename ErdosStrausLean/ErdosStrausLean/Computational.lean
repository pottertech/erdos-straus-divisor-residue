/-
  Computational Verification for the Erdős-Straus Conjecture

  Explicit solutions for ALL 2 ≤ n ≤ 10000.
  9999 cases, each verified by norm_num.
  Uses interval_cases for automatic exhaustiveness (no admit needed).
-/

import Mathlib
import ErdosStrausLean.Basic

set_option maxHeartbeats 1000000000

open Nat

/-- Solutions for n ∈ [2, 500]. -/
theorem es_block_0 (n : ℕ) (hn_lo : 2 ≤ n) (hn_hi : n ≤ 500) :
