/-- Erdős-Straus Conjecture for all 2 ≤ n ≤ 10000. -/
theorem erdos_straus_bounded_10000 (n : ℕ) (hn : 2 ≤ n) (hn_bound : n ≤ 10000) :
    ∃ x y z : ℕ, erdos_straus n x y z := by
  by_cases h1 : n ≤ 500
  · exact es_block_0 n (by omega) h1
  · by_cases h2 : n ≤ 1000
    · exact es_block_1 n (by omega) h2
    · by_cases h3 : n ≤ 1500
      · exact es_block_2 n (by omega) h3
      · by_cases h4 : n ≤ 2000
        · exact es_block_3 n (by omega) h4
        · by_cases h5 : n ≤ 2500
          · exact es_block_4 n (by omega) h5
          · by_cases h6 : n ≤ 3000
            · exact es_block_5 n (by omega) h6
            · by_cases h7 : n ≤ 3500
              · exact es_block_6 n (by omega) h7
              · by_cases h8 : n ≤ 4000
                · exact es_block_7 n (by omega) h8
                · by_cases h9 : n ≤ 4500
                  · exact es_block_8 n (by omega) h9
                  · by_cases h10 : n ≤ 5000
                    · exact es_block_9 n (by omega) h10
                    · by_cases h11 : n ≤ 5500
                      · exact es_block_10 n (by omega) h11
                      · by_cases h12 : n ≤ 6000
                        · exact es_block_11 n (by omega) h12
                        · by_cases h13 : n ≤ 6500
                          · exact es_block_12 n (by omega) h13
                          · by_cases h14 : n ≤ 7000
                            · exact es_block_13 n (by omega) h14
                            · by_cases h15 : n ≤ 7500
                              · exact es_block_14 n (by omega) h15
                              · by_cases h16 : n ≤ 8000
                                · exact es_block_15 n (by omega) h16
                                · by_cases h17 : n ≤ 8500
                                  · exact es_block_16 n (by omega) h17
                                  · by_cases h18 : n ≤ 9000
                                    · exact es_block_17 n (by omega) h18
                                    · by_cases h19 : n ≤ 9500
                                      · exact es_block_18 n (by omega) h19
                                      · exact es_block_19 n (by omega) (by omega)
